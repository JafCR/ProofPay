%% ProofPay architecture (matches docs/architecture.png). The agent is the
%% project; Pacta Protocol is an unmodified MIT dependency consumed over its
%% MCP server. Everything below is live on Cloud Run us-central1 (Phase B).
%% Numbered edges follow the story order used in the diagram and the demo video.
flowchart LR
    subgraph buyer["Buyer"]
        caller["Demo page / Operator<br/>POST /missions { goal, budget }"]
    end

    subgraph agentsvc["ProofPay agent (Cloud Run)"]
        api["FastAPI endpoints<br/>/missions · /events/delivery · /sweep"]
        orch["Orchestrator<br/>Wake 1: hire + fund escrow · sleeps<br/>Wake 2: re-verify proofs + settle<br/>(no process running in between)"]
        judge["Gemini 3.5 Flash judge<br/>google-genai + ADK<br/>picks offers · assesses proofs<br/>ADVISORY: can veto, never force a payment"]
        gate["policy.py<br/>DETERMINISTIC RELEASE GATE<br/>5 checks P1..P5 -> RELEASE | DISPUTE"]
        state["Firestore<br/>persisted mission trace<br/>no state in memory between wakes"]
    end

    subgraph pacta["Pacta Protocol marketplace (Cloud Run, unmodified MIT dependency)"]
        market["offers · escrow ledger<br/>staked collateral · registry verification"]
        provider["Provider (law firm / bot)<br/>delivers work, honest or fraudulent"]
        registry["Government registry<br/>source of truth, re-checked at pay time"]
    end

    subgraph gcp["Google Cloud plumbing"]
        ps["Pub/Sub<br/>delivery event wakes the agent"]
        sched["Cloud Scheduler<br/>/sweep every 6 h wakes sleeping missions"]
        sm["Secret Manager<br/>Gemini API key"]
    end

    caller -->|"1 mission created"| api
    orch -->|"2 search offers · sign contract · fund escrow (via Pacta MCP tools)"| market
    provider -->|"4 delivers"| market
    ps -.->|"5 wakes the agent"| api
    orch -->|"6 re-verify every certificate"| registry
    judge -.->|"7 advisory only"| gate
    gate -->|"8 sole release authority: releases escrow or opens a dispute"| market

    api --> orch
    orch --> state
    sched -.-> api
    sm -.-> judge

    classDef gateStyle fill:#4353FF,stroke:#58E0FF,color:#fff,stroke-width:2px;
    classDef pactaStyle fill:#0E1420,stroke:#3FA34D,color:#E6EBF5;
    class gate gateStyle;
    class market,provider,registry pactaStyle;
